<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoinFlipMVVM.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CoinFlipMVVM"
    xmlns:views="clr-namespace:CoinFlipMVVM.Views"
    Title="CoinFlipMVVM">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Coin"
        ContentTemplate="{DataTemplate views:CoinView}"
        Route="CoinView" />

</Shell>
